# Secret key, at least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty: generated and stored in the data volume (/data/.secret_key). Cloud: set a fixed value and keep it safe.
# The app refuses to start with a sample value. When rotating, move the old key to SECRET_KEY_OLD so stored
# AI API keys can still be decrypted.
SECRET_KEY=
SECRET_KEY_OLD=
# Product name shown in the UI
PRODUCT_NAME=VFAS
# Send cookies over HTTPS only (enabled automatically for https requests from a trusted proxy).
# Self-hosting over plain HTTP in a LAN: false.
COOKIE_SECURE=true
# Code required by the first-run /setup page (empty = generated and printed in the startup log)
SETUP_TOKEN=
# Trusted proxies allowed to send X-Forwarded-For (Traefik in Docker). Port 8000 exposed directly: 127.0.0.1
FORWARDED_ALLOW_IPS=172.16.0.0/12
# Sign out after this many idle minutes; absolute session lifetime in hours
SESSION_IDLE_MINUTES=120
SESSION_HOURS=12
# SaaS: let anyone sign up with a new company. Self-hosting for one company: false (invite members in the app).
ALLOW_SIGNUP=false
# SaaS: signups per IP per hour; max companies one user may create (0 = unlimited)
SIGNUP_PER_IP_HOUR=5
MAX_COMPANIES_PER_USER=20
# Public URL, used in invitation, verification and password-reset links (e.g. https://vfas.example.com)
PUBLIC_URL=
# Outgoing email (SMTP): invitations, password reset, email verification. Empty SMTP_HOST = email disabled.
# Required before ALLOW_SIGNUP=true. Test with: python -m app.cli send-test-email --to you@example.com
SMTP_HOST=
SMTP_PORT=587
# starttls (587) | ssl (465) | none (local relay only)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender, e.g. VFAS <no-reply@example.com> (empty = SMTP_USERNAME)
MAIL_FROM=
# auto: sign-ups must verify their email when ALLOW_SIGNUP=true and SMTP is set | required | off
EMAIL_VERIFICATION=auto
# Domain for Traefik
APP_DOMAIN=vfas.example.com
TRAEFIK_CERTRESOLVER=letsencrypt
# PostgreSQL (recommended for SaaS): uncomment DATABASE_URL in docker-compose.yml.
# Strong password, required when using the postgres profile.
POSTGRES_PASSWORD=
# Web worker processes. SQLite: always 1. PostgreSQL: 2-4 depending on RAM.
WEB_CONCURRENCY=1
# Maximum size of attachments / imported files (MB)
MAX_UPLOAD_MB=10
# AI assistant – defaults used when a company has not configured its own (optional). OpenAI Chat Completions protocol.
# Claude example: AI_DEFAULT_BASE_URL=https://api.anthropic.com/v1/  AI_DEFAULT_MODEL=claude-opus-5-5
AI_DEFAULT_BASE_URL=
AI_DEFAULT_API_KEY=
AI_DEFAULT_MODEL=
# Questions per user per day when the platform's default API key is used (the key is only sent to AI_DEFAULT_BASE_URL)
AI_DEFAULT_DAILY_LIMIT=100
# Allow the AI assistant to call internal servers (Ollama, vLLM in the LAN) when ALLOW_SIGNUP=true.
# By default SaaS mode blocks internal addresses and requires https (SSRF protection); self-hosting allows them.
AI_ALLOW_PRIVATE_URLS=0
# Encrypt backup/export files (optional, recommended). Store the passphrase separately – losing it means losing the backups.
BACKUP_PASSPHRASE=
